# Copiez ce fichier en ".env" et remplissez vos clés secrètes
# Ne partagez JAMAIS le fichier .env avec personne

# France Travail API (optionnel)
# Inscrivez-vous sur https://francetravail.io pour obtenir ces clés
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# LinkedIn — cookie de session (optionnel, améliore la fiabilité)
# Comment obtenir votre cookie li_at :
#  1. Connectez-vous à LinkedIn dans votre navigateur
#  2. Appuyez sur F12 (Outils développeur) > Onglet "Application"
#  3. Dans le menu de gauche : Stockage > Cookies > https://www.linkedin.com
#  4. Trouvez la ligne "li_at" et copiez la valeur
LINKEDIN_LI_AT_COOKIE=

# Engagement Jeunes — cookies de session (optionnel, améliore la fiabilité)
# Comment obtenir vos cookies :
#  1. Connectez-vous sur https://www.engagement-jeunes.com
#  2. F12 → onglet "Réseau" (Network)
#  3. Cliquez sur n'importe quelle requête vers engagement-jeunes.com
#  4. Dans "En-têtes de requête" (Request Headers), trouvez la ligne "cookie:"
#  5. Copiez TOUTE la valeur (ex: PHPSESSID=abc123; session=xyz...)
ENGAGEMENT_JEUNES_COOKIES=

# Discord Webhook URL (requis pour les notifications)
# Guide : Paramètres du canal Discord > Intégrations > Webhooks > Créer un webhook
DISCORD_WEBHOOK_URL=
